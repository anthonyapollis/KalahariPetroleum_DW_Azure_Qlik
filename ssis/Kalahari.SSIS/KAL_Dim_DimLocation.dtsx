        <SQLTask:SqlTaskData SQLTask:Connection="KalahariDW_SSIS" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;DECLARE @actions TABLE (act nvarchar(10));&#xA;MERGE dw.DimLocation AS t&#xA;USING stg.DimLocation AS s&#xA;   ON t.SourceLocationId = s.SourceLocationId&#xA;WHEN MATCHED AND EXISTS (SELECT s.AFSDepotId, s.LocationDescription, s.IsFixed, s.IsMobile, s.Capacity, s.IsActive&#xA;                         EXCEPT&#xA;                         SELECT t.AFSDepotId, t.LocationDescription, t.IsFixed, t.IsMobile, t.Capacity, t.IsActive) THEN&#xA;    UPDATE SET AFSDepotId = s.AFSDepotId, LocationDescription = s.LocationDescription, IsFixed = s.IsFixed, IsMobile = s.IsMobile, Capacity = s.Capacity, IsActive = s.IsActive&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (SourceLocationId, AFSDepotId, LocationDescription, IsFixed, IsMobile, Capacity, IsActive)&#xA;    VALUES (s.SourceLocationId, s.AFSDepotId, s.LocationDescription, s.IsFixed, s.IsMobile, s.Capacity, s.IsActive)&#xA;OUTPUT $action INTO @actions;&#xA;SELECT SUM(CASE WHEN act = 'INSERT' THEN 1 ELSE 0 END) AS Inserted,&#xA;       SUM(CASE WHEN act = 'UPDATE' THEN 1 ELSE 0 END) AS Updated&#xA;FROM (SELECT act FROM @actions UNION ALL SELECT NULL) x;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding SQLTask:DtsVariableName="User::MergeInserted" SQLTask:ResultName="0" />
          <SQLTask:ResultBinding SQLTask:DtsVariableName="User::MergeUpdated" SQLTask:ResultName="1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:CreationName="Microsoft.ExpressionTask" DTS:DTSID="{E4971327-7B10-4968-BB49-6B613946976C}" DTS:ExecutableType="Microsoft.ExpressionTask" DTS:LocaleID="-1" DTS:ObjectName="EXP Rows written _ inserted + updated" DTS:refId="Package\EXP Rows written _ inserted + updated" DTS:TaskContact="Expression Task;Microsoft Corporation; SQL Server 2014; © 2014 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:ObjectData>
        <ExpressionTask Expression="@[User::RowsWritten] = @[User::MergeInserted] + @[User::MergeUpdated]" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{C5B77229-C507-4DD7-B6E9-13E7BC28BB15}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL Log run success" DTS:refId="Package\SQL Log run success" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2014; © 2014 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="KalahariDW_SSIS" SQLTask:SqlStatementSource="UPDATE etl.PackageRun SET EndTime = SYSDATETIME(), Status = 'Succeeded', RowsRead = ?, RowsWritten = ?, RowsRejected = ? WHERE RunId = ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding SQLTask:DataType="3" SQLTask:DtsVariableName="User::RowsRead" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="0" SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding SQLTask:DataType="3" SQLTask:DtsVariableName="User::RowsWritten" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="1" SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding SQLTask:DataType="3" SQLTask:DtsVariableName="User::RowsRejected" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="2" SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding SQLTask:DataType="3" SQLTask:DtsVariableName="User::RunId" SQLTask:ParameterDirection="Input" SQLTask:ParameterName="3" SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
