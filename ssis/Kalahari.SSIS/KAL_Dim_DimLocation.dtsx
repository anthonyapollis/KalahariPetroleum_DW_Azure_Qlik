    <DTS:PrecedenceConstraint DTS:CreationName="" DTS:DTSID="{6EC09F87-7F05-4E62-9FEB-AFFE0080A957}" DTS:From="Package\SQL Merge into dw DimLocation" DTS:LogicalAnd="True" DTS:ObjectName="Constraint_SQL Merge into dw DimLocation_To_EXP Rows written _ inserted + updated" DTS:refId="Package.PrecedenceConstraints[Constraint_SQL Merge into dw DimLocation_To_EXP Rows written _ inserted + updated]" DTS:To="Package\EXP Rows written _ inserted + updated" />
    <DTS:PrecedenceConstraint DTS:CreationName="" DTS:DTSID="{59241412-1284-4599-973C-A655461BE32E}" DTS:From="Package\EXP Rows written _ inserted + updated" DTS:LogicalAnd="True" DTS:ObjectName="Constraint_EXP Rows written _ inserted + updated_To_SQL Log run success" DTS:refId="Package.PrecedenceConstraints[Constraint_EXP Rows written _ inserted + updated_To_SQL Log run success]" DTS:To="Package\SQL Log run success" />
