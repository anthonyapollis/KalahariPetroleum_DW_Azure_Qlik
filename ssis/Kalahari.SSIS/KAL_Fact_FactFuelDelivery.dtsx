    <DTS:Variable DTS:CreationName="" DTS:DTSID="{5350E397-E3A7-48AA-BE57-54FC57542DAF}" DTS:EvaluateAsExpression="True" DTS:Expression="&quot;SELECT d.Id AS SourceFuelDeliveryId, YEAR(d.DeliveryTime)*10000 + MONTH(d.DeliveryTime)*100 + DAY(d.DeliveryTime) AS DateKey, d.DeliveryTime, d.LocationId, d.ProductId, d.Volume AS VolumeLitres, d.AFSTankDeliveryEventId, CAST(d.DocumentNumber AS nvarchar(200)) AS DocumentNumber, d.IsDuplicate, d.IsActive FROM dbo.datFuelDelivery d WITH (NOLOCK) WHERE d.Id &gt; &quot; + (DT_WSTR, 12) @[User::LastSourceId]" DTS:IncludeInDebugDump="2345" DTS:Namespace="User" DTS:ObjectName="SourceQuery">
      <DTS:VariableValue DTS:DataType="8">SELECT d.Id AS SourceFuelDeliveryId, YEAR(d.DeliveryTime)*10000 + MONTH(d.DeliveryTime)*100 + DAY(d.DeliveryTime) AS DateKey, d.DeliveryTime, d.LocationId, d.ProductId, d.Volume AS VolumeLitres, d.AFSTankDeliveryEventId, CAST(d.DocumentNumber AS nvarchar(200)) AS DocumentNumber, d.IsDuplicate, d.IsActive FROM dbo.datFuelDelivery d WITH (NOLOCK) WHERE d.Id &gt; 0</DTS:VariableValue>
