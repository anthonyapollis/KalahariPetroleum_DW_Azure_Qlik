    <DTS:Variable DTS:CreationName="" DTS:DTSID="{E15FB393-60B9-4C18-B9FA-5F71761CC7E7}" DTS:EvaluateAsExpression="True" DTS:Expression="&quot;SELECT a.Id AS SourceAFSRecordId, YEAR(a.TransactionDateTime)*10000 + MONTH(a.TransactionDateTime)*100 + DAY(a.TransactionDateTime) AS DateKey, a.TransactionDateTime, a.EquipmentId, a.LocationId, a.ProductId, cc.CostCentreHash, a.Litres, a.HoursOdoReading, a.CalculatedODO, a.FuelEventId, CAST(a.VoucherNumber AS nvarchar(200)) AS VoucherNumber, CAST(a.DeviceId AS nvarchar(200)) AS DeviceId, CAST(a.Pump AS nvarchar(200)) AS Pump, CAST(a.TransactionPlate AS nvarchar(200)) AS TransactionPlate, CAST(a.VehicleCategoryDescription AS nvarchar(200)) AS VehicleCategoryDescription, a.IsActive FROM dbo.datAFSRecord a WITH (NOLOCK) LEFT JOIN (SELECT FuelEventId, MIN(CAST(HASHBYTES('SHA1', CONCAT(IIF(CostCentreName IS NULL,'~',''),UPPER(RTRIM(CAST(LEFT(CostCentreName,200) AS varchar(200)))),'|',IIF(ResponsibilityCode IS NULL,'~',''),UPPER(RTRIM(CAST(LEFT(ResponsibilityCode,200) AS varchar(200)))),'|',IIF(BusinessRevenueCode IS NULL,'~',''),UPPER(RTRIM(CAST(LEFT(BusinessRevenueCode,200) AS varchar(200)))),'|',IIF(TaxRebateCode IS NULL,'~',''),UPPER(RTRIM(CAST(LEFT(TaxRebateCode,200) AS varchar(200)))),'|',IIF(GlAccount IS NULL,'~',''),UPPER(RTRIM(CAST(LEFT(GlAccount,200) AS varchar(200)))))) AS binary(20))) AS CostCentreHash FROM dbo.CostCentre WITH (NOLOCK) WHERE FuelEventId IS NOT NULL GROUP BY FuelEventId) cc ON cc.FuelEventId = a.FuelEventId WHERE a.Id &gt; &quot; + (DT_WSTR, 12) @[User::LastSourceId]" DTS:IncludeInDebugDump="2345" DTS:Namespace="User" DTS:ObjectName="SourceQuery">
      <DTS:VariableValue DTS:DataType="8">SELECT a.Id AS SourceAFSRecordId, YEAR(a.TransactionDateTime)*10000 + MONTH(a.TransactionDateTime)*100 + DAY(a.TransactionDateTime) AS DateKey, a.TransactionDateTime, a.EquipmentId, a.LocationId, a.ProductId, cc.CostCentreHash, a.Litres, a.HoursOdoReading, a.CalculatedODO, a.FuelEventId, CAST(a.VoucherNumber AS nvarchar(200)) AS VoucherNumber, CAST(a.DeviceId AS nvarchar(200)) AS DeviceId, CAST(a.Pump AS nvarchar(200)) AS Pump, CAST(a.TransactionPlate AS nvarchar(200)) AS TransactionPlate, CAST(a.VehicleCategoryDescription AS nvarchar(200)) AS VehicleCategoryDescription, a.IsActive FROM dbo.datAFSRecord a WITH (NOLOCK) LEFT JOIN (SELECT FuelEventId, MIN(CAST(HASHBYTES('SHA1', CONCAT(IIF(CostCentreName IS NULL,'~',''),UPPER(RTRIM(CAST(LEFT(CostCentreName,200) AS varchar(200)))),'|',IIF(ResponsibilityCode IS NULL,'~',''),UPPER(RTRIM(CAST(LEFT(ResponsibilityCode,200) AS varchar(200)))),'|',IIF(BusinessRevenueCode IS NULL,'~',''),UPPER(RTRIM(CAST(LEFT(BusinessRevenueCode,200) AS varchar(200)))),'|',IIF(TaxRebateCode IS NULL,'~',''),UPPER(RTRIM(CAST(LEFT(TaxRebateCode,200) AS varchar(200)))),'|',IIF(GlAccount IS NULL,'~',''),UPPER(RTRIM(CAST(LEFT(GlAccount,200) AS varchar(200)))))) AS binary(20))) AS CostCentreHash FROM dbo.CostCentre WITH (NOLOCK) WHERE FuelEventId IS NOT NULL GROUP BY FuelEventId) cc ON cc.FuelEventId = a.FuelEventId WHERE a.Id &gt; 0</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
