    <DTS:Variable DTS:CreationName="" DTS:DTSID="{58111D77-FE8E-4491-8A10-07870EFFFAAC}" DTS:EvaluateAsExpression="True" DTS:Expression="&quot;SELECT m.Id AS SourceMeterReadingId, YEAR(m.ReadingDate)*10000 + MONTH(m.ReadingDate)*100 + DAY(m.ReadingDate) AS DateKey, m.ReadingDate, m.PreviousReadingDate, m.EquipmentId, m.MeasuringPoint, m.ReadingDiff, m.CounterReading, m.PreviousReading, m.ConsumptionTypeId, m.ReadingTypeId, m.IsActive FROM dbo.datMeterReading m WITH (NOLOCK) WHERE m.Id &gt; &quot; + (DT_WSTR, 12) @[User::LastSourceId]" DTS:IncludeInDebugDump="2345" DTS:Namespace="User" DTS:ObjectName="SourceQuery">
      <DTS:VariableValue DTS:DataType="8">SELECT m.Id AS SourceMeterReadingId, YEAR(m.ReadingDate)*10000 + MONTH(m.ReadingDate)*100 + DAY(m.ReadingDate) AS DateKey, m.ReadingDate, m.PreviousReadingDate, m.EquipmentId, m.MeasuringPoint, m.ReadingDiff, m.CounterReading, m.PreviousReading, m.ConsumptionTypeId, m.ReadingTypeId, m.IsActive FROM dbo.datMeterReading m WITH (NOLOCK) WHERE m.Id &gt; 0</DTS:VariableValue>
