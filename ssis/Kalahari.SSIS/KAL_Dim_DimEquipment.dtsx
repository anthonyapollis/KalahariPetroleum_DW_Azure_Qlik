    <DTS:Executable DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{77024272-9DAA-4C9D-B7C6-BDA206FAD98B}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL Merge into dw DimEquipment" DTS:refId="Package\SQL Merge into dw DimEquipment" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2014; © 2014 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="KalahariDW_SSIS" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;DECLARE @actions TABLE (act nvarchar(10));&#xA;MERGE dw.DimEquipment AS t&#xA;USING stg.DimEquipment AS s&#xA;   ON t.SourceEquipmentId = s.SourceEquipmentId&#xA;WHEN MATCHED AND EXISTS (SELECT s.AFSEquipmentId, s.FleetId, s.RegNumber, s.EquipmentDescription, s.MakeName, s.ModelName, s.VehicleTypeName, s.IsEligibleVehicleType, s.ConsumptionTypeName, s.TankSize, s.DecommissionDate, s.IsActive, s.EligibleActivityKey, s.EligibilityClass&#xA;                         EXCEPT&#xA;                         SELECT t.AFSEquipmentId, t.FleetId, t.RegNumber, t.EquipmentDescription, t.MakeName, t.ModelName, t.VehicleTypeName, t.IsEligibleVehicleType, t.ConsumptionTypeName, t.TankSize, t.DecommissionDate, t.IsActive, t.EligibleActivityKey, t.EligibilityClass) THEN&#xA;    UPDATE SET AFSEquipmentId = s.AFSEquipmentId, FleetId = s.FleetId, RegNumber = s.RegNumber, EquipmentDescription = s.EquipmentDescription, MakeName = s.MakeName, ModelName = s.ModelName, VehicleTypeName = s.VehicleTypeName, IsEligibleVehicleType = s.IsEligibleVehicleType, ConsumptionTypeName = s.ConsumptionTypeName, TankSize = s.TankSize, DecommissionDate = s.DecommissionDate, IsActive = s.IsActive, EligibleActivityKey = s.EligibleActivityKey, EligibilityClass = s.EligibilityClass&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (SourceEquipmentId, AFSEquipmentId, FleetId, RegNumber, EquipmentDescription, MakeName, ModelName, VehicleTypeName, IsEligibleVehicleType, ConsumptionTypeName, TankSize, DecommissionDate, IsActive, EligibleActivityKey, EligibilityClass)&#xA;    VALUES (s.SourceEquipmentId, s.AFSEquipmentId, s.FleetId, s.RegNumber, s.EquipmentDescription, s.MakeName, s.ModelName, s.VehicleTypeName, s.IsEligibleVehicleType, s.ConsumptionTypeName, s.TankSize, s.DecommissionDate, s.IsActive, s.EligibleActivityKey, s.EligibilityClass)&#xA;OUTPUT $action INTO @actions;&#xA;SELECT SUM(CASE WHEN act = 'INSERT' THEN 1 ELSE 0 END) AS Inserted,&#xA;       SUM(CASE WHEN act = 'UPDATE' THEN 1 ELSE 0 END) AS Updated&#xA;FROM (SELECT act FROM @actions UNION ALL SELECT NULL) x;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding SQLTask:DtsVariableName="User::MergeInserted" SQLTask:ResultName="0" />
          <SQLTask:ResultBinding SQLTask:DtsVariableName="User::MergeUpdated" SQLTask:ResultName="1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:CreationName="Microsoft.ExpressionTask" DTS:DTSID="{3B01638B-ED66-4AF8-8D6F-671BCD345B33}" DTS:ExecutableType="Microsoft.ExpressionTask" DTS:LocaleID="-1" DTS:ObjectName="EXP Rows written _ inserted + updated" DTS:refId="Package\EXP Rows written _ inserted + updated" DTS:TaskContact="Expression Task;Microsoft Corporation; SQL Server 2014; © 2014 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:ObjectData>
        <ExpressionTask Expression="@[User::RowsWritten] = @[User::MergeInserted] + @[User::MergeUpdated]" />
      </DTS:ObjectData>
    </DTS:Executable>
