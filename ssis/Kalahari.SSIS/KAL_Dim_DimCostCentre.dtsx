    <DTS:Executable DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{9E2AB176-D2BC-402F-BE3B-4F8DADF652BB}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="SQL Merge into dw DimCostCentre" DTS:refId="Package\SQL Merge into dw DimCostCentre" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2014; © 2014 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="KalahariDW_SSIS" SQLTask:ResultType="ResultSetType_SingleRow" SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;DECLARE @actions TABLE (act nvarchar(10));&#xA;MERGE dw.DimCostCentre AS t&#xA;USING stg.DimCostCentre AS s&#xA;   ON t.CostCentreHash = s.CostCentreHash&#xA;WHEN MATCHED AND EXISTS (SELECT s.CostCentreName, s.ResponsibilityCode, s.BusinessRevenueCode, s.TaxRebateCode, s.GlAccount&#xA;                         EXCEPT&#xA;                         SELECT t.CostCentreName, t.ResponsibilityCode, t.BusinessRevenueCode, t.TaxRebateCode, t.GlAccount) THEN&#xA;    UPDATE SET CostCentreName = s.CostCentreName, ResponsibilityCode = s.ResponsibilityCode, BusinessRevenueCode = s.BusinessRevenueCode, TaxRebateCode = s.TaxRebateCode, GlAccount = s.GlAccount&#xA;WHEN NOT MATCHED BY TARGET THEN&#xA;    INSERT (CostCentreHash, CostCentreName, ResponsibilityCode, BusinessRevenueCode, TaxRebateCode, GlAccount)&#xA;    VALUES (s.CostCentreHash, s.CostCentreName, s.ResponsibilityCode, s.BusinessRevenueCode, s.TaxRebateCode, s.GlAccount)&#xA;OUTPUT $action INTO @actions;&#xA;SELECT SUM(CASE WHEN act = 'INSERT' THEN 1 ELSE 0 END) AS Inserted,&#xA;       SUM(CASE WHEN act = 'UPDATE' THEN 1 ELSE 0 END) AS Updated&#xA;FROM (SELECT act FROM @actions UNION ALL SELECT NULL) x;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding SQLTask:DtsVariableName="User::MergeInserted" SQLTask:ResultName="0" />
          <SQLTask:ResultBinding SQLTask:DtsVariableName="User::MergeUpdated" SQLTask:ResultName="1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:CreationName="Microsoft.ExpressionTask" DTS:DTSID="{ABADCE4A-05C0-4C17-88FE-512C39EC56C0}" DTS:ExecutableType="Microsoft.ExpressionTask" DTS:LocaleID="-1" DTS:ObjectName="EXP Rows written _ inserted + updated" DTS:refId="Package\EXP Rows written _ inserted + updated" DTS:TaskContact="Expression Task;Microsoft Corporation; SQL Server 2014; © 2014 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:ObjectData>
        <ExpressionTask Expression="@[User::RowsWritten] = @[User::MergeInserted] + @[User::MergeUpdated]" />
      </DTS:ObjectData>
    </DTS:Executable>
